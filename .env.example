# Canonical public domain (domain ownership is confirmed by owner; live DNS/HTTPS not yet verified).
NEXT_PUBLIC_SITE_URL=https://fashion.azenith.ca

# Keep the pilot demo out of search engines until it is commercially ready.
# Change to true only after the release checklist and legal/commercial content are approved.
NEXT_PUBLIC_PUBLIC_LAUNCH=false

# Phase 1: local non-binding garment enquiry does not require credentials.
# Never expose secret keys in NEXT_PUBLIC_ variables.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
